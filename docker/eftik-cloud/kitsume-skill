#!/usr/bin/env python3
"""Install a complete SkillHub or HTTPS ZIP package into Pi's skills directory.

Usage: kitsume-skill install @publisher/skill
       kitsume-skill install https://example.com/skill.zip
"""
import hashlib
import ipaddress
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


MAX_ARCHIVE = 10 * 1024 * 1024
SKILLHUB_REF = re.compile(r"^@([A-Za-z0-9][A-Za-z0-9_-]{0,63})/([A-Za-z0-9][A-Za-z0-9_-]{0,63})$")
PLACEHOLDER = re.compile(
    r"^\s*请根据\s+https://(?:www\.)?skillhub\.cn/install/skillhub\.md\s*[，,]\s*安装\s+"
    r"(@[A-Za-z0-9_-]+/[A-Za-z0-9_-]+)\s*[。.]?\s*$"
)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, msg, headers, newurl):
        return None


def public_https(url):
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != "https" or not parts.hostname or parts.username or parts.password or parts.port:
        raise ValueError("技能包必须使用公开 HTTPS 地址")
    addresses = socket.getaddrinfo(parts.hostname, 443, type=socket.SOCK_STREAM)
    if not addresses or any(not ipaddress.ip_address(item[4][0]).is_global for item in addresses):
        raise ValueError("技能包地址不能指向内网")
    return url


def download(url, destination):
    opener = urllib.request.build_opener(NoRedirect())
    for _ in range(4):
        public_https(url)
        try:
            response = opener.open(urllib.request.Request(url, headers={"Accept": "application/zip"}), timeout=30)
        except urllib.error.HTTPError as error:
            if error.code in (301, 302, 303, 307, 308):
                location = error.headers.get("Location")
                error.close()
                if not location:
                    raise ValueError("技能包重定向地址缺失")
                url = urllib.parse.urljoin(url, location)
                continue
            raise ValueError("技能包下载失败（HTTP %d）" % error.code) from error
        with response:
            if response.status != 200:
                raise ValueError("技能包下载失败（HTTP %d）" % response.status)
            length = response.headers.get("Content-Length")
            if length and int(length) > MAX_ARCHIVE:
                raise ValueError("技能包超过 10 MB 限制")
            total = 0
            with open(destination, "wb") as output:
                while chunk := response.read(64 * 1024):
                    total += len(chunk)
                    if total > MAX_ARCHIVE:
                        raise ValueError("技能包超过 10 MB 限制")
                    output.write(chunk)
            return
    raise ValueError("技能包重定向次数过多")


def remove_placeholder(root, reference):
    registry = Path(os.environ.get("GW_SKILLS_PATH", "/home/node/.pi/eftik-skills.json"))
    if not registry.is_file():
        return
    data = json.loads(registry.read_text(encoding="utf-8"))
    skills = data.get("skills", [])
    removed = []
    kept = []
    for skill in skills:
        prompt = skill.get("prompt", "")
        match = PLACEHOLDER.fullmatch(prompt) if isinstance(prompt, str) else None
        skill_id = skill.get("id", "")
        if match and match.group(1) == reference and re.fullmatch(r"[a-f0-9-]{36}", skill_id):
            removed.append(skill_id)
        else:
            kept.append(skill)
    if not removed:
        return
    data["skills"] = kept
    temp = registry.with_name(registry.name + ".tmp")
    temp.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
    os.chmod(temp, 0o600)
    os.replace(temp, registry)
    for skill_id in removed:
        shutil.rmtree(root / skill_id, ignore_errors=True)


def main(argv):
    if len(argv) != 3 or argv[1] != "install":
        print(__doc__.strip(), file=sys.stderr)
        return 2
    source = argv[2].strip()
    match = SKILLHUB_REF.fullmatch(source)
    if match:
        namespace, slug = match.groups()
        query = urllib.parse.urlencode({"namespace": namespace, "slug": slug})
        url = "https://api.skillhub.cn/api/v1/download?" + query
        skill_id = namespace + "--" + slug
    else:
        if not source.startswith("https://"):
            raise ValueError("请输入 SkillHub 标识 @发布者/技能名 或 HTTPS ZIP 链接")
        url = source
        basename = Path(urllib.parse.urlsplit(url).path).stem
        slug = re.sub(r"[^A-Za-z0-9_-]", "-", basename).strip("-") or "skill"
        skill_id = "zip--" + slug
    if len(skill_id) > 64:
        skill_id = skill_id[:51] + "-" + hashlib.sha256(skill_id.encode()).hexdigest()[:12]
    root = Path(os.environ.get("PI_CODING_AGENT_DIR", "/home/node/.pi/agent")) / "skills"
    root.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="kitsume-skill-") as temporary:
        archive = Path(temporary) / "skill.zip"
        download(url, archive)
        subprocess.run([sys.executable, str(Path(__file__).resolve().with_name("skill-installer.py")),
                        str(archive), str(root / skill_id)], check=True)
    if match:
        remove_placeholder(root, source)
    content = (root / skill_id / "SKILL.md").read_text(encoding="utf-8")
    title = re.search(r"^name:\s*(.+)$", content, re.MULTILINE)
    name = title.group(1).strip().strip("\"'") if title else skill_id
    print("INSTALLED_SKILL %s %s" % (skill_id, name))
    print("已安装完整技能包；请阅读 SKILL.md 的授权或依赖说明，按需完成配置。")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print("技能安装失败：%s" % error, file=sys.stderr)
        sys.exit(1)
