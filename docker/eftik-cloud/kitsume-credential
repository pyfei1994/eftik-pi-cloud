#!/usr/bin/env python3
"""Run a skill command with only its requested parameters without printing values.

Usage: kitsume-credential run SKILL_ID NAME[,NAME...] -- command [args...]
"""
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


def resolve_skill_id(skill_id):
    root = Path(os.environ.get("PI_CODING_AGENT_DIR", "/home/node/.pi/agent")) / "skills"
    if (root / skill_id / "SKILL.md").is_file():
        return skill_id
    matches = []
    for item in root.iterdir() if root.is_dir() else []:
        file = item / "SKILL.md"
        if not item.is_dir() or not file.is_file() or file.stat().st_size > 100 * 1024:
            continue
        if item.name.endswith("--" + skill_id):
            matches.append(item.name)
            continue
        content = file.read_text(encoding="utf-8-sig", errors="replace")
        header = re.match(r"^---\s*\n(.*?)\n---(?:\n|$)", content, re.DOTALL)
        title = re.search(r"^name:\s*(.+)$", header.group(1), re.MULTILINE | re.IGNORECASE) if header else None
        if title and title.group(1).strip().strip("\"'") == skill_id:
            matches.append(item.name)
    if len(matches) > 1:
        raise ValueError("技能名对应多个已安装技能，请使用 Skills 页面对应的完整 skill-id")
    return matches[0] if matches else skill_id


def main():
    if len(sys.argv) < 6 or sys.argv[1] != "run" or sys.argv[4] != "--":
        print(__doc__.strip(), file=sys.stderr)
        return 2
    skill_id = sys.argv[2]
    reference = re.fullmatch(r"@([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)", skill_id)
    if reference:
        skill_id = "--".join(reference.groups())
    names = [name for name in sys.argv[3].split(",") if name]
    if not re.fullmatch(r"[\w-]{1,64}", skill_id) or not names or any(
        not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,63}", name) for name in names
    ):
        print("Invalid skill ID or parameter names", file=sys.stderr)
        return 2
    try:
        skill_id = resolve_skill_id(skill_id)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 2
    token = os.environ.get("KITSUME_CREDENTIAL_TOKEN", "")
    if not token:
        print("工作台版本过旧，缺少凭证服务令牌。请在工作台页面更新工作台镜像。", file=sys.stderr)
        return 1
    base = os.environ.get("KITSUME_API_BASE", "https://kitsume.eftik.com").rstrip("/")
    env = os.environ.copy()
    env.pop("KITSUME_CREDENTIAL_TOKEN", None)
    for name in names:
        url = base + "/v1/workspace/credential-cli/" + urllib.parse.quote(skill_id) + "/" + name
        request = urllib.request.Request(url, headers={"X-Credential-Token": token, "Accept": "application/json"})
        try:
            with urllib.request.urlopen(request, timeout=15) as response:
                payload = json.load(response)
        except urllib.error.HTTPError as error:
            if error.code == 404:
                print("MISSING_CREDENTIAL " + skill_id + "/" + name
                      + "；请到工作台 → Skills 技能 → API Key/凭证添加", file=sys.stderr)
                return 3
            print("Credential service failed (HTTP %d)" % error.code, file=sys.stderr)
            return 1
        except Exception:
            print("Credential service unavailable", file=sys.stderr)
            return 1
        value = (payload.get("data") or {}).get("value") if payload.get("code") == 0 else None
        if not isinstance(value, str):
            print("Credential service returned an invalid response", file=sys.stderr)
            return 1
        env[name] = value
    return subprocess.call(sys.argv[5:], env=env)


if __name__ == "__main__":
    sys.exit(main())
